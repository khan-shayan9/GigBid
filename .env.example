APP_ENV=development
APP_SECRET_KEY=replace_me
DATABASE_URL=postgresql+psycopg://gigbid:gigbid@localhost:5432/gigbid
POSTGRES_PASSWORD=gigbid
REDIS_URL=redis://localhost:6379/0
MARKETPLACE_MODE=gigsim
GIGSIM_BASE_URL=http://localhost:8081
GIGSIM_API_TOKEN=replace_me
# GigSim user=token pairs; the Marketplace MCP server reads the same list to call GigSim per user (users are defined in data/gigsim_seed/sim_config.json)
GIGSIM_TOKENS=ai_ml_engineer=replace_me,fullstack_dev=replace_me_too,data_analyst=replace_me_three
GIGSIM_ADMIN_TOKEN=replace_me
# Comma list of seed folders; add a grader folder here to load new jobs and clients
GIGSIM_SEED_DIRS=data/gigsim_seed
GIGSIM_CONFIG=data/gigsim_seed/sim_config.json
GIGSIM_DB_PATH=data/processed/gigsim.sqlite
# Optional fixed start of simulated time (ISO 8601); defaults to the first start, remembered
GIGSIM_EPOCH=
# Set to off to disable seeded 5xx errors (rate limits still apply)
GIGSIM_FAULTS=on
# Active platform policy file (switch to data/policy_pack/v2.yaml for the policy update)
GIGSIM_POLICY=data/policy_pack/v2.yaml
# Optional LLM client simulation (set client_sim.mode to llm in sim_config.json); OpenAI-compatible
GIGSIM_LLM_BASE_URL=
GIGSIM_LLM_MODEL=
GIGSIM_LLM_API_KEY=
GIGSIM_LLM_PROMPT=data/gigsim_seed/client_sim_prompt.md
MODEL_PROFILE=open
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
LANGSMITH_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Marketplace MCP server (port 8082). Its own Bearer tokens, user=token pairs.
MARKETPLACE_MCP_TOKENS=ai_ml_engineer=replace_me,fullstack_dev=replace_me_too,data_analyst=replace_me_three
# Calls per user per minute; keep under GigSim's per-user limit (sim_config.json rate_limit)
MARKETPLACE_RATE_PER_MINUTE=20
MARKETPLACE_AUDIT_LOG=data/processed/audit/marketplace.jsonl
MARKETPLACE_PUBLIC_URL=http://localhost:8082
MARKETPLACE_HOST=127.0.0.1
MARKETPLACE_PORT=8082
# User for stdio sessions (MCP Inspector, Claude Desktop), which carry no Bearer token
MARKETPLACE_STDIO_USER=ai_ml_engineer

# Portfolio MCP server (port 8083): read-only evidence search over data/personas/<user>/
PORTFOLIO_MCP_TOKENS=ai_ml_engineer=replace_me,fullstack_dev=replace_me_too,data_analyst=replace_me_three
PORTFOLIO_PUBLIC_URL=http://localhost:8083
PORTFOLIO_HOST=127.0.0.1
PORTFOLIO_PORT=8083
PORTFOLIO_STDIO_USER=ai_ml_engineer

# Workspace MCP server (port 8084): local mock calendar holds and email drafts
WORKSPACE_MCP_TOKENS=ai_ml_engineer=replace_me,fullstack_dev=replace_me_too,data_analyst=replace_me_three
WORKSPACE_PUBLIC_URL=http://localhost:8084
WORKSPACE_HOST=127.0.0.1
WORKSPACE_PORT=8084
WORKSPACE_STDIO_USER=ai_ml_engineer

# Live mode (Upwork) OAuth tokens are encrypted per user with this Fernet key. Generate one with
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# GitHub MCP (hosted, read-only toolsets): a fine-grained PAT with read access to public repos
GITHUB_PERSONAL_ACCESS_TOKEN=

# Retrieval (agent/config.yaml `rag`): override the shipped variant and the index backend.
RAG_VARIANT=
RAG_INDEX=
