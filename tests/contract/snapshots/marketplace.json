{
  "create_proposal_draft": {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true,
      "readOnlyHint": false
    },
    "description": "Create a proposal draft on the marketplace (not sent to the client, costs nothing).",
    "inputSchema": {
      "properties": {
        "bid_amount_usd": {
          "exclusiveMinimum": 0,
          "maximum": 1000000,
          "title": "Bid Amount Usd",
          "type": "number"
        },
        "bid_type": {
          "enum": [
            "fixed",
            "hourly"
          ],
          "title": "Bid Type",
          "type": "string"
        },
        "cover_letter": {
          "maxLength": 5000,
          "minLength": 1,
          "title": "Cover Letter",
          "type": "string"
        },
        "dry_run": {
          "default": true,
          "description": "True (default) returns exactly what would be sent and what it costs, and changes nothing. False is allowed only after the user approved.",
          "title": "Dry Run",
          "type": "boolean"
        },
        "idempotency_key": {
          "description": "Reuse the same key when retrying; a repeated key never acts twice.",
          "maxLength": 200,
          "minLength": 8,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Idempotency Key",
          "type": "string"
        },
        "job_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_:~-]+$",
          "title": "Job Id",
          "type": "string"
        },
        "screening_answers": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Screening Answers",
          "type": "array"
        }
      },
      "required": [
        "job_id",
        "cover_letter",
        "bid_type",
        "bid_amount_usd",
        "idempotency_key"
      ],
      "title": "create_proposal_draftArguments",
      "type": "object"
    },
    "outputSchema": {
      "$defs": {
        "Bid": {
          "properties": {
            "amount_usd": {
              "exclusiveMinimum": 0,
              "maximum": 1000000,
              "title": "Amount Usd",
              "type": "number"
            },
            "type": {
              "enum": [
                "fixed",
                "hourly"
              ],
              "title": "Type",
              "type": "string"
            }
          },
          "required": [
            "type",
            "amount_usd"
          ],
          "title": "Bid",
          "type": "object"
        }
      },
      "properties": {
        "bid": {
          "$ref": "#/$defs/Bid"
        },
        "connects_cost": {
          "title": "Connects Cost",
          "type": "integer"
        },
        "cover_letter": {
          "title": "Cover Letter",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "dry_run": {
          "default": false,
          "description": "True: a preview; nothing was stored or sent",
          "title": "Dry Run",
          "type": "boolean"
        },
        "job_id": {
          "title": "Job Id",
          "type": "string"
        },
        "proposal_id": {
          "title": "Proposal Id",
          "type": "string"
        },
        "screening_answers": {
          "items": {
            "type": "string"
          },
          "title": "Screening Answers",
          "type": "array"
        },
        "status": {
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "proposal_id",
        "job_id",
        "status",
        "cover_letter",
        "bid",
        "screening_answers",
        "connects_cost",
        "created_at"
      ],
      "title": "Proposal",
      "type": "object"
    }
  },
