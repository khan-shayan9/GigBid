{
  "draft_email": {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false
    },
    "description": "Save an email draft for the user to review and send themselves. Never sends.",
    "inputSchema": {
      "properties": {
        "body": {
          "maxLength": 5000,
          "minLength": 1,
          "title": "Body",
          "type": "string"
        },
        "dry_run": {
          "default": true,
          "description": "True (default) shows the result and changes nothing. False is allowed only after the user approved.",
          "title": "Dry Run",
          "type": "boolean"
        },
        "idempotency_key": {
          "description": "Reuse the same key when retrying; a repeated key never acts twice.",
          "maxLength": 200,
          "minLength": 8,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Idempotency Key",
          "type": "string"
        },
        "subject": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        },
        "to": {
          "maxLength": 200,
          "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
          "title": "To",
          "type": "string"
        }
      },
      "required": [
        "to",
        "subject",
        "body",
        "idempotency_key"
      ],
      "title": "draft_emailArguments",
      "type": "object"
    },
    "outputSchema": {
      "properties": {
        "body": {
          "title": "Body",
          "type": "string"
        },
        "draft_id": {
          "title": "Draft Id",
          "type": "string"
        },
        "dry_run": {
          "title": "Dry Run",
          "type": "boolean"
        },
        "status": {
          "const": "draft",
          "default": "draft",
          "title": "Status",
          "type": "string"
        },
        "subject": {
          "title": "Subject",
          "type": "string"
        },
        "to": {
          "title": "To",
          "type": "string"
        }
      },
      "required": [
        "draft_id",
        "to",
        "subject",
        "body",
        "dry_run"
      ],
      "title": "EmailDraft",
      "type": "object"
    }
  },
  "find_free_slots": {
    "annotations": {
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "Free slots inside working hours (weekdays, the user's timezone), earliest first.",
    "inputSchema": {
      "properties": {
        "duration_minutes": {
          "default": 30,
          "maximum": 240,
          "minimum": 15,
          "title": "Duration Minutes",
          "type": "integer"
        },
        "limit": {
          "default": 5,
          "maximum": 20,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "window_end": {
          "format": "date-time",
          "title": "Window End",
          "type": "string"
        },
        "window_start": {
          "format": "date-time",
          "title": "Window Start",
          "type": "string"
        }
      },
      "required": [
        "window_start",
        "window_end"
      ],
      "title": "find_free_slotsArguments",
      "type": "object"
    },
    "outputSchema": {
      "$defs": {
        "Slot": {
          "properties": {
            "end": {
              "format": "date-time",
              "title": "End",
              "type": "string"
            },
            "start": {
              "format": "date-time",
              "title": "Start",
              "type": "string"
            }
          },
          "required": [
            "start",
            "end"
          ],
          "title": "Slot",
          "type": "object"
        }
      },
      "properties": {
        "slots": {
          "items": {
            "$ref": "#/$defs/Slot"
          },
          "title": "Slots",
          "type": "array"
        },
        "timezone": {
          "title": "Timezone",
          "type": "string"
        }
      },
      "required": [
        "slots",
        "timezone"
      ],
      "title": "SlotList",
      "type": "object"
    }
  },
  "hold_slot": {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false
    },
    "description": "Place a tentative hold on the calendar, e.g. for an interview the client may accept.",
    "inputSchema": {
      "properties": {
        "dry_run": {
          "default": true,
          "description": "True (default) shows the result and changes nothing. False is allowed only after the user approved.",
          "title": "Dry Run",
          "type": "boolean"
        },
        "duration_minutes": {
          "default": 30,
          "maximum": 240,
          "minimum": 15,
          "title": "Duration Minutes",
          "type": "integer"
        },
        "idempotency_key": {
          "description": "Reuse the same key when retrying; a repeated key never acts twice.",
          "maxLength": 200,
          "minLength": 8,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Idempotency Key",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "start",
        "title",
        "idempotency_key"
      ],
      "title": "hold_slotArguments",
      "type": "object"
    },
    "outputSchema": {
      "properties": {
        "dry_run": {
          "title": "Dry Run",
          "type": "boolean"
        },
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "hold_id": {
          "title": "Hold Id",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        },
        "status": {
          "const": "tentative",
          "default": "tentative",
          "title": "Status",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "hold_id",
        "title",
        "dry_run"
      ],
      "title": "Hold",
      "type": "object"
    }
  }
}
